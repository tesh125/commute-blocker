# Copy to .env for local `vercel dev`, and set these as real environment
# variables in Vercel (Project Settings -> Environment Variables) for the
# deployed proxy. Never commit .env.

# Required. Your Google Maps API key (Routes API, Geocoding API, Weather
# API all enabled) — this is the whole point of the proxy: it lives here,
# server-side, and is never shipped to the extension.
MAPS_API_KEY=

# Optional. Max requests per hour, per client, per endpoint. Defaults to 60
# if unset.
HOURLY_REQUEST_CAP=60

# Optional. If set, every request must include a matching X-Access-Code
# header (see PROXY_ACCESS_CODE in options.js / background.js). Share this
# value with people out-of-band (text, not GitHub) — leave it unset to run
# the proxy without this gate.
PROXY_ACCESS_CODE=
