# Copy to .env for local `vercel dev`, and set these as real environment
# variables in Vercel (Project Settings -> Environment Variables) for the
# deployed proxy. Never commit .env.

# Required. Your Google Maps API key (Routes API, Geocoding API, Weather
# API all enabled) — this is the whole point of the proxy: it lives here,
# server-side, and is never shipped to the extension.
MAPS_API_KEY=

# Optional. Max requests per hour, per client, per endpoint. Defaults to 60
# if unset.
HOURLY_REQUEST_CAP=60

# Optional. Max requests per hour, per endpoint, combined across every
# caller — a ceiling on total spend once this proxy is used by more than a
# handful of people you know (e.g. a public Chrome Web Store listing).
# Unset means no global cap, just the per-client one above. Size it to what
# you're willing to pay for: with the Routes/Geocoding APIs priced around
# $5 per 1000 calls, a cap of 2000/hour across all three endpoints caps
# worst-case spend at roughly $10/hour (~$7,200/month if sustained
# continuously, which a real cap should prevent long before then). Pair
# this with a budget alert in Google Cloud Console (Billing -> Budgets &
# alerts) on the project holding MAPS_API_KEY — that's the real backstop,
# since this counter resets on a serverless cold start.
GLOBAL_HOURLY_CAP=
